{
  "name": "estatepro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server -c blue,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "start": "concurrently -k -n client,server -c blue,green \"npm run start:client\" \"npm run start:server\"",
    "start:client": "npm run start --prefix client",
    "start:server": "npm run start --prefix server",
    "db:generate": "npm run prisma:generate --prefix server",
    "db:migrate": "npm run prisma:migrate --prefix server",
    "db:seed": "npm run prisma:seed --prefix server",
    "lint": "eslint client server",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "eslint-config-prettier": "^10.1.8",
    "@eslint/eslintrc": "^3.3.1"
  },
  "overrides": {
    "tailwindcss": "^3.4.17"
  }
}
