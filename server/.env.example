# Runtime environment; use production in deployment.
NODE_ENV=development
# Port exposed by the Express API.
PORT=4000
# Neon pooled connection string used by the application at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Neon direct connection string used by Prisma migrations and administrative tasks.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate a random secret of at least 32 characters for signing JWTs.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# JWT expiry duration accepted by jsonwebtoken (for example 7d).
JWT_EXPIRES_IN=7d
# Name used for the HTTP-only session cookie.
AUTH_COOKIE_NAME=estatepro_session
# SameSite policy for the authentication cookie; use none only when the client and API are on different sites.
AUTH_COOKIE_SAME_SITE=lax
# Maximum session-cookie age in milliseconds.
AUTH_COOKIE_MAX_AGE_MS=604800000
# Frontend origin permitted by credentialed CORS.
CLIENT_URL=http://localhost:3000
# Number of bcrypt hashing rounds.
BCRYPT_ROUNDS=12
# Rate limit window length in milliseconds.
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per IP during the rate limit window.
RATE_LIMIT_MAX=120
# Cloudinary cloud identifier for listing image uploads.
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
# Cloudinary API key used only by the server.
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
# Cloudinary API secret used only by the server.
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET
# Cloudinary folder for uploaded property imagery.
CLOUDINARY_FOLDER=estatepro
# Email address for the optional admin user created by the seed script.
SEED_ADMIN_EMAIL=admin@example.com
# Password for the optional seeded admin account; replace with a strong password.
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
# Email address for the sample agent account created by the seed script.
SEED_AGENT_EMAIL=agent@example.com
# Password for the sample agent account created by the seed script.
SEED_AGENT_PASSWORD=REPLACE_WITH_A_STRONG_AGENT_PASSWORD
